{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/autoresearch/run-manifest.schema.json",
  "title": "Immutable autoresearch run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "campaign_id",
    "authorization_epoch",
    "experiment_id",
    "evaluation_id",
    "candidate_id",
    "stage",
    "suite",
    "backend",
    "metric_contract_id",
    "working_directory",
    "command",
    "environment",
    "concurrency_policy",
    "worker_count",
    "timeouts",
    "hashes",
    "expected_outputs",
    "lifecycle",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "authorization_epoch": {"type": "integer", "minimum": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "comparator_run_id": {"type": ["string", "null"]},
    "stage": {"enum": ["smoke", "screen", "independent", "canonical", "promotion-audit"]},
    "suite": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "metric_contract_id": {"type": "string", "minLength": 1},
    "working_directory": {"type": "string", "minLength": 1},
    "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "concurrency_policy": {"type": "string", "minLength": 1},
    "resource_key": {"type": "string", "minLength": 1},
    "worker_count": {"type": "integer", "minimum": 1},
    "timeouts": {"type": "object"},
    "hashes": {
      "type": "object",
      "required": ["source", "build", "harness", "suite", "inputs", "configuration", "toolchain", "environment"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "expected_outputs": {"type": "array", "items": {"type": "string"}},
    "lifecycle": {"enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCEL_REQUESTED", "CANCELLED", "STALE"]},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true
}
