{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/autoresearch/event.schema.json",
  "title": "Autoresearch ledger event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "campaign_id",
    "authorization_epoch",
    "event_type",
    "actor",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "authorization_epoch": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["campaign_created", "authorized", "hypothesis_added", "candidate_snapshotted", "evaluation_queued", "evaluation_started", "evaluation_finished", "late_evaluation_observed", "decision_recorded", "promotion_started", "promotion_verified", "stop_requested", "stopped", "paused", "completed", "legacy_migrated", "garbage_collection_started", "garbage_collection_recovered", "garbage_collection_delete_committed", "garbage_collection_finalized"]},
    "actor": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
