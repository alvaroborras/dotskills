{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/autoresearch/campaign.schema.json",
  "title": "Autoresearch campaign",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "created_at",
    "authorization_epoch",
    "lifecycle",
    "goal",
    "scope",
    "git_mode",
    "iteration_policy",
    "metric_contract_id",
    "metric_contract",
    "artifact_policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "authorization_epoch": {"type": "integer", "minimum": 1},
    "lifecycle": {"enum": ["RUNNING", "PAUSED", "STOP_REQUESTED", "STOPPED", "COMPLETE"]},
    "stopped_reason": {"type": ["string", "null"]},
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "git_mode": {"enum": ["experiment-worktree", "experiment-branch", "ledger-only"]},
    "iteration_policy": {"type": "object"},
    "metric_contract_id": {"type": "string", "minLength": 1},
    "metric_contract": {"$ref": "metric-contract.schema.json"},
    "artifact_policy": {"type": "object"}
  },
  "additionalProperties": true
}
