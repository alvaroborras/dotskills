#!/home/alvaro/.agents/skills/gepa-optimize-anything/.venv/bin/python
"""Codex/OpenCode agent entrypoint for GEPA agentic engines.

GEPA engines exec this basename on PATH with a ``--print`` JSON contract.
This skill never runs a third-party agent CLI under that name: the process
always re-execs Codex (default) or OpenCode.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any


# Basename GEPA engines look up on PATH / rewrite to an absolute path.
GEPA_AGENT_ENTRY = Path(__file__).name

VALUE_FLAGS = frozenset({
    "--allowedTools",
    "--append-system-prompt",
    "--disallowedTools",
    "--effort",
    "--max-budget-usd",
    "--max-turns",
    "--model",
    "--output-format",
    "--permission-mode",
    "--resume",
    "--session-id",
    "--settings",
    "--system-prompt",
    "--system-prompt-file",
})
BOOLEAN_FLAGS = frozenset({
    "--continue",
    "--dangerously-skip-permissions",
    "--fork-session",
    "--include-partial-messages",
    "--no-session-persistence",
    "--print",
    "--strict-mcp-config",
    "--verbose",
})

# Upstream GEPA may pass these as --model; they are not valid Codex/OpenCode ids.
_UPSTREAM_DEFAULT_MODEL_NICKNAMES = frozenset({
    "sonnet",
    "opus",
    "haiku",
    "claude-sonnet-4-6",
    "claude-opus-4",
    "claude-haiku-4",
})


class AgentArgumentError(ValueError):
    """An unsupported agent CLI argument was supplied to the shim."""


def parse_agent_request(argv: list[str]) -> tuple[str, str | None, str | None]:
    """Extract the printable prompt and optional system instructions.

    GEPA invokes the agent entry as ``<entry> --print --output-format json ... PROMPT``.
    ``--print`` is a boolean: treating its following token as a prompt would send
    ``--output-format`` to Codex as a positional argument. Upstream-only controls
    are consumed here; the shim emits GEPA's JSON result envelope itself, so
    ``--output-format`` must not be translated to Codex's unrelated ``--output-schema``.
    """
    printed = False
    prompt_parts: list[str] = []
    system_parts: list[str] = []
    requested_model: str | None = None
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument == "--":
            prompt_parts.extend(argv[index + 1:])
            break
        if argument in BOOLEAN_FLAGS:
            printed = printed or argument == "--print"
            index += 1
            continue
        flag, equals, supplied = argument.partition("=")
        if flag in VALUE_FLAGS:
            if equals:
                value = supplied
            else:
                index += 1
                if index >= len(argv):
                    raise AgentArgumentError(f"option {flag} requires a value")
                value = argv[index]
            if flag == "--system-prompt":
                system_parts = [value]
            elif flag == "--append-system-prompt":
                system_parts.append(value)
            elif flag == "--system-prompt-file":
                try:
                    system_parts = [Path(value).read_text(encoding="utf-8")]
                except OSError as exc:
                    raise AgentArgumentError(f"cannot read {flag} file {value!r}: {exc}") from exc
            elif flag == "--model":
                requested_model = value
            # Model, max-turn, session, permissions, budget, and output-format are
            # upstream CLI controls. Codex/OpenCode do not share their semantics,
            # so consume them rather than forwarding invalid flags.
            index += 1
            continue
        if argument.startswith("-"):
            raise AgentArgumentError(f"unsupported option: {argument}")
        prompt_parts.append(argument)
        index += 1
    if not printed:
        raise AgentArgumentError("only supports --print mode")
    if not prompt_parts:
        raise AgentArgumentError("--print requires a prompt")
    return " ".join(prompt_parts), "\n\n".join(part for part in system_parts if part), requested_model


def text(value_: Any) -> str:
    if isinstance(value_, str):
        return value_
    if isinstance(value_, dict):
        for key in ("text", "content", "message", "result"):
            if key in value_:
                found = text(value_[key])
                if found:
                    return found
    if isinstance(value_, list):
        return "".join(text(item) for item in value_)
    return ""


def _resolve_model(preferred: str | None, fallback: str | None) -> str | None:
    """Prefer backend-specific env, then caller model, then skill default.

    Upstream GEPA default model nicknames / Anthropic-style ids are ignored so
    Codex/OpenCode never receive an invalid model id.
    """
    for candidate in (preferred, fallback, os.environ.get("GEPA_DEFAULT_MODEL"), "gpt-5.6-luna"):
        if not candidate:
            continue
        lowered = candidate.strip().lower()
        if (
            lowered in _UPSTREAM_DEFAULT_MODEL_NICKNAMES
            or lowered.startswith("claude")
            or lowered.startswith("anthropic/")
        ):
            continue
        return candidate
    return "gpt-5.6-luna"


if "--print" not in sys.argv[1:]:
    print("gepa agent shim only supports --print mode", file=sys.stderr)
    raise SystemExit(2)
try:
    prompt, system_prompt, requested_model = parse_agent_request(sys.argv[1:])
except AgentArgumentError as exc:
    print(f"gepa agent shim {exc}", file=sys.stderr)
    raise SystemExit(2)
if system_prompt:
    prompt = f"{system_prompt}\n\n{prompt}"
backend = os.environ.get("GEPA_AGENT_BACKEND", "codex").lower()
if backend not in {"codex", "opencode"}:
    print(
        f"gepa agent shim: unsupported GEPA_AGENT_BACKEND={backend!r}; expected 'codex' or 'opencode'",
        file=sys.stderr,
    )
    raise SystemExit(2)

if backend == "codex":
    executable = os.environ.get("CODEX_BIN") or shutil.which("codex")
    if not executable:
        print("gepa Codex shim: `codex` was not found on PATH", file=sys.stderr)
        raise SystemExit(127)
    command = [executable, "exec", "--json", "--dangerously-bypass-approvals-and-sandbox", "-C", os.getcwd()]
    model = _resolve_model(os.environ.get("GEPA_CODEX_MODEL"), requested_model)
    if model:
        command += ["--model", model]
    # Use stdin rather than a positional prompt so any prompt beginning with
    # dashes is unambiguously data. System-prompt content is folded into stdin
    # because Codex has no separate system-prompt flag matching the upstream CLI.
    command.append("-")
else:  # backend == "opencode" (validated above)
    executable = os.environ.get("OPENCODE_BIN") or shutil.which("opencode")
    if not executable:
        print("gepa OpenCode shim: `opencode` was not found on PATH", file=sys.stderr)
        raise SystemExit(127)
    command = [executable, "run", "--format", "json", "--auto", "--dir", os.getcwd()]
    model = _resolve_model(os.environ.get("GEPA_OPENCODE_MODEL"), requested_model)
    if model:
        command += ["--model", model]
    command.append(prompt)
completed = subprocess.run(
    command,
    capture_output=True,
    check=False,
    input=prompt if backend == "codex" else None,
    text=True,
)
parts: list[str] = []
for line in completed.stdout.splitlines():
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        continue
    if backend == "codex":
        item = event.get("item") if isinstance(event, dict) else None
        part = text(item) if isinstance(item, dict) and item.get("type") == "agent_message" else ""
        if event.get("type") == "response.output_text.done":
            part = text(event)
    else:
        part = text(event)
    if part:
        parts.append(part)
print(json.dumps({
    "type": "result", "result": "".join(parts),
    "is_error": completed.returncode != 0, "total_cost_usd": 0.0, "usage": {},
}))
if completed.returncode:
    print(completed.stderr[-4000:], file=sys.stderr, end="")
raise SystemExit(completed.returncode)
