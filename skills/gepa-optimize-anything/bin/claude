#!/home/alvaro/.agents/skills/gepa-optimize-anything/.venv/bin/python
"""Codex/OpenCode agent entrypoint for GEPA agentic engines.

GEPA engines exec this basename on PATH with a ``--print`` JSON contract.
This skill never runs a third-party agent CLI under that name: the process
always re-execs Codex (default) or OpenCode.

Agent models are the GPT-5.6 family only: luna / terra / sol, each with a
supported reasoning (thinking) level.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any


# Basename GEPA engines look up on PATH / rewrite to an absolute path.
GEPA_AGENT_ENTRY = Path(__file__).name

# GPT-5.6 family used by this skill (Codex slugs). OpenCode uses openai/<slug>.
GPT56_FAMILY: dict[str, dict[str, Any]] = {
    "luna": {
        "slug": "gpt-5.6-luna",
        "default_effort": "medium",
        "efforts": frozenset({"low", "medium", "high", "xhigh", "max"}),
    },
    "terra": {
        "slug": "gpt-5.6-terra",
        "default_effort": "medium",
        "efforts": frozenset({"low", "medium", "high", "xhigh", "max", "ultra"}),
    },
    "sol": {
        "slug": "gpt-5.6-sol",
        "default_effort": "low",
        "efforts": frozenset({"low", "medium", "high", "xhigh", "max", "ultra"}),
    },
}
DEFAULT_VARIANT = "luna"
DEFAULT_SLUG = GPT56_FAMILY[DEFAULT_VARIANT]["slug"]
DEFAULT_EFFORT = "high"  # optimization default; per-variant floor is applied if unsupported
SLUG_TO_VARIANT = {meta["slug"]: name for name, meta in GPT56_FAMILY.items()}

VALUE_FLAGS = frozenset({
    "--allowedTools",
    "--append-system-prompt",
    "--disallowedTools",
    "--effort",
    "--max-budget-usd",
    "--max-turns",
    "--model",
    "--output-format",
    "--permission-mode",
    "--resume",
    "--session-id",
    "--settings",
    "--system-prompt",
    "--system-prompt-file",
})
BOOLEAN_FLAGS = frozenset({
    "--continue",
    "--dangerously-skip-permissions",
    "--fork-session",
    "--include-partial-messages",
    "--no-session-persistence",
    "--print",
    "--strict-mcp-config",
    "--verbose",
})

# Upstream GEPA may pass these as --model; they are not GPT-5.6 family ids.
_UPSTREAM_DEFAULT_MODEL_NICKNAMES = frozenset({
    "sonnet",
    "opus",
    "haiku",
    "claude-sonnet-4-6",
    "claude-opus-4",
    "claude-haiku-4",
})


class AgentArgumentError(ValueError):
    """An unsupported agent CLI argument was supplied to the shim."""


def parse_agent_request(argv: list[str]) -> tuple[str, str | None, str | None, str | None]:
    """Extract prompt, system text, optional model, and optional effort."""
    printed = False
    prompt_parts: list[str] = []
    system_parts: list[str] = []
    requested_model: str | None = None
    requested_effort: str | None = None
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument == "--":
            prompt_parts.extend(argv[index + 1:])
            break
        if argument in BOOLEAN_FLAGS:
            printed = printed or argument == "--print"
            index += 1
            continue
        flag, equals, supplied = argument.partition("=")
        if flag in VALUE_FLAGS:
            if equals:
                value = supplied
            else:
                index += 1
                if index >= len(argv):
                    raise AgentArgumentError(f"option {flag} requires a value")
                value = argv[index]
            if flag == "--system-prompt":
                system_parts = [value]
            elif flag == "--append-system-prompt":
                system_parts.append(value)
            elif flag == "--system-prompt-file":
                try:
                    system_parts = [Path(value).read_text(encoding="utf-8")]
                except OSError as exc:
                    raise AgentArgumentError(f"cannot read {flag} file {value!r}: {exc}") from exc
            elif flag == "--model":
                requested_model = value
            elif flag == "--effort":
                requested_effort = value
            # Other upstream CLI controls are consumed, not forwarded.
            index += 1
            continue
        if argument.startswith("-"):
            raise AgentArgumentError(f"unsupported option: {argument}")
        prompt_parts.append(argument)
        index += 1
    if not printed:
        raise AgentArgumentError("only supports --print mode")
    if not prompt_parts:
        raise AgentArgumentError("--print requires a prompt")
    return (
        " ".join(prompt_parts),
        "\n\n".join(part for part in system_parts if part),
        requested_model,
        requested_effort,
    )


def text(value_: Any) -> str:
    if isinstance(value_, str):
        return value_
    if isinstance(value_, dict):
        for key in ("text", "content", "message", "result"):
            if key in value_:
                found = text(value_[key])
                if found:
                    return found
    if isinstance(value_, list):
        return "".join(text(item) for item in value_)
    return ""


def _normalize_model_token(raw: str | None) -> str | None:
    if not raw:
        return None
    token = raw.strip()
    if not token:
        return None
    lowered = token.lower()
    # OpenCode-style provider/model → bare slug
    if "/" in lowered:
        lowered = lowered.rsplit("/", 1)[-1]
    # Accept bare variant names: luna / terra / sol
    if lowered in GPT56_FAMILY:
        return GPT56_FAMILY[lowered]["slug"]
    if lowered.startswith("gpt-5.6-"):
        return lowered
    return token


def _is_rejected_upstream_model(token: str | None) -> bool:
    if not token:
        return False
    lowered = token.strip().lower()
    if "/" in lowered:
        lowered = lowered.rsplit("/", 1)[-1]
    return (
        lowered in _UPSTREAM_DEFAULT_MODEL_NICKNAMES
        or lowered.startswith("claude")
        or lowered.startswith("anthropic/")
        or token.strip().lower().startswith("anthropic/")
    )


def _resolve_variant_and_effort(
    preferred_model: str | None,
    fallback_model: str | None,
    preferred_effort: str | None,
    fallback_effort: str | None,
) -> tuple[str, str, str]:
    """Return (variant, codex_slug, effort) for the GPT-5.6 family."""
    candidates = (
        preferred_model,
        fallback_model,
        os.environ.get("GEPA_DEFAULT_MODEL"),
        DEFAULT_SLUG,
    )
    slug = DEFAULT_SLUG
    for candidate in candidates:
        if _is_rejected_upstream_model(candidate):
            continue
        normalized = _normalize_model_token(candidate)
        if not normalized:
            continue
        if normalized in SLUG_TO_VARIANT:
            slug = normalized
            break
        # Unknown non-family id → fall back to default rather than pass through.
        if normalized.startswith("gpt-5.6-"):
            # allow only known family slugs
            continue
    variant = SLUG_TO_VARIANT[slug]
    meta = GPT56_FAMILY[variant]
    # Prefer CLI --effort (engine_config) over env defaults the overlay injects.
    effort_candidates = (
        fallback_effort,
        preferred_effort,
        os.environ.get("GEPA_REASONING_EFFORT"),
        os.environ.get("GEPA_MODEL_VARIANT"),  # OpenCode naming alias
        DEFAULT_EFFORT,
        meta["default_effort"],
    )
    effort = meta["default_effort"]
    for candidate in effort_candidates:
        if not candidate:
            continue
        lowered = candidate.strip().lower()
        if lowered in meta["efforts"]:
            effort = lowered
            break
    return variant, slug, effort


def _opencode_model_id(slug: str) -> str:
    configured = os.environ.get("GEPA_OPENCODE_PROVIDER", "openai").strip() or "openai"
    return f"{configured}/{slug}"


if "--print" not in sys.argv[1:]:
    print("gepa agent shim only supports --print mode", file=sys.stderr)
    raise SystemExit(2)
try:
    prompt, system_prompt, requested_model, requested_effort = parse_agent_request(sys.argv[1:])
except AgentArgumentError as exc:
    print(f"gepa agent shim {exc}", file=sys.stderr)
    raise SystemExit(2)
if system_prompt:
    prompt = f"{system_prompt}\n\n{prompt}"
backend = os.environ.get("GEPA_AGENT_BACKEND", "codex").lower()
if backend not in {"codex", "opencode"}:
    print(
        f"gepa agent shim: unsupported GEPA_AGENT_BACKEND={backend!r}; expected 'codex' or 'opencode'",
        file=sys.stderr,
    )
    raise SystemExit(2)

env_effort = os.environ.get("GEPA_REASONING_EFFORT") or os.environ.get("GEPA_MODEL_VARIANT")

if backend == "codex":
    executable = os.environ.get("CODEX_BIN") or shutil.which("codex")
    if not executable:
        print("gepa Codex shim: `codex` was not found on PATH", file=sys.stderr)
        raise SystemExit(127)
    _, slug, effort = _resolve_variant_and_effort(
        os.environ.get("GEPA_CODEX_MODEL"),
        requested_model,
        env_effort,
        requested_effort,
    )
    command = [
        executable,
        "exec",
        "--json",
        "--dangerously-bypass-approvals-and-sandbox",
        "-C",
        os.getcwd(),
        "--model",
        slug,
        "-c",
        f"model_reasoning_effort={effort}",
        # stdin carries the prompt so leading dashes stay data.
        "-",
    ]
else:  # backend == "opencode"
    executable = os.environ.get("OPENCODE_BIN") or shutil.which("opencode")
    if not executable:
        print("gepa OpenCode shim: `opencode` was not found on PATH", file=sys.stderr)
        raise SystemExit(127)
    _, slug, effort = _resolve_variant_and_effort(
        os.environ.get("GEPA_OPENCODE_MODEL"),
        requested_model,
        env_effort,
        requested_effort,
    )
    command = [
        executable,
        "run",
        "--format",
        "json",
        "--auto",
        "--dir",
        os.getcwd(),
        "--model",
        _opencode_model_id(slug),
        "--variant",
        effort,
        prompt,
    ]

completed = subprocess.run(
    command,
    capture_output=True,
    check=False,
    input=prompt if backend == "codex" else None,
    text=True,
)
parts: list[str] = []
for line in completed.stdout.splitlines():
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        continue
    if backend == "codex":
        item = event.get("item") if isinstance(event, dict) else None
        part = text(item) if isinstance(item, dict) and item.get("type") == "agent_message" else ""
        if event.get("type") == "response.output_text.done":
            part = text(event)
    else:
        part = text(event)
    if part:
        parts.append(part)
print(json.dumps({
    "type": "result", "result": "".join(parts),
    "is_error": completed.returncode != 0, "total_cost_usd": 0.0, "usage": {},
}))
if completed.returncode:
    print(completed.stderr[-4000:], file=sys.stderr, end="")
raise SystemExit(completed.returncode)
