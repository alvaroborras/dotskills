#!/usr/bin/env python3
"""Translate GEPA's print-oriented agent contract into Codex exec JSON."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any, NoReturn

DEFAULT_MODEL = "gpt-5.6-luna"
DEFAULT_EFFORT = "high"
VALUE_FLAGS = frozenset(
    {
        "--allowedTools",
        "--append-system-prompt",
        "--disallowedTools",
        "--effort",
        "--max-budget-usd",
        "--max-turns",
        "--model",
        "--output-format",
        "--permission-mode",
        "--resume",
        "--session-id",
        "--settings",
        "--system-prompt",
        "--system-prompt-file",
    }
)
BOOLEAN_FLAGS = frozenset(
    {
        "--continue",
        "--dangerously-skip-permissions",
        "--fork-session",
        "--include-partial-messages",
        "--no-session-persistence",
        "--print",
        "--strict-mcp-config",
        "--verbose",
    }
)


class AgentArgumentError(ValueError):
    """Raised when GEPA supplies an unsupported command shape."""


def _diagnostic(
    stage: str, reason: str, *, detail: str = "", exit_code: int = 2
) -> NoReturn:
    lines = [
        "[GEPA_AGENT_ERROR]",
        f"stage: {stage}",
        f"reason: {reason}",
        f"working_directory: {Path.cwd()}",
        f"launcher: {Path(__file__).resolve()}",
        f"executable: {os.environ.get('CODEX_BIN') or shutil.which('codex') or '(unresolved)'}",
        f"model: {os.environ.get('GEPA_CODEX_MODEL') or DEFAULT_MODEL}",
        f"reasoning_effort: {os.environ.get('GEPA_REASONING_EFFORT') or DEFAULT_EFFORT}",
        "prompt: redacted",
    ]
    if detail:
        lines.extend(("backend_detail:", detail[-4000:]))
    lines.extend(
        (
            "how_to_fix:",
            "  - Verify Codex is installed and authenticated.",
            "  - Set CODEX_BIN, GEPA_CODEX_MODEL, or GEPA_REASONING_EFFORT if needed.",
            "  - Run scripts/preflight.py --engine autoresearch.",
        )
    )
    print("\n".join(lines), file=sys.stderr, flush=True)
    raise SystemExit(exit_code)


def _option_names(argv: list[str]) -> str:
    return (
        ", ".join(
            sorted({item.split("=", 1)[0] for item in argv if item.startswith("-")})
        )
        or "(none)"
    )


def parse_request(argv: list[str]) -> tuple[str, str | None, str | None]:
    prompt_parts: list[str] = []
    system_parts: list[str] = []
    requested_model: str | None = None
    requested_effort: str | None = None
    printed = False
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument == "--":
            prompt_parts.extend(argv[index + 1 :])
            break
        if argument in BOOLEAN_FLAGS:
            printed = printed or argument == "--print"
            index += 1
            continue
        flag, equals, supplied = argument.partition("=")
        if flag in VALUE_FLAGS:
            if not equals:
                index += 1
                if index >= len(argv):
                    raise AgentArgumentError(f"option {flag} requires a value")
                supplied = argv[index]
            if flag == "--model":
                requested_model = supplied
            elif flag == "--effort":
                requested_effort = supplied
            elif flag == "--system-prompt":
                system_parts = [supplied]
            elif flag == "--append-system-prompt":
                system_parts.append(supplied)
            elif flag == "--system-prompt-file":
                try:
                    system_parts = [Path(supplied).read_text(encoding="utf-8")]
                except OSError as exc:
                    raise AgentArgumentError(f"cannot read {flag} file: {exc}") from exc
            index += 1
            continue
        if argument.startswith("-"):
            raise AgentArgumentError(f"unsupported option: {argument}")
        prompt_parts.append(argument)
        index += 1
    if not printed:
        raise AgentArgumentError("only --print mode is supported")
    if not prompt_parts:
        raise AgentArgumentError("--print requires a prompt")
    prompt = " ".join(prompt_parts)
    system = "\n\n".join(part for part in system_parts if part)
    if system:
        prompt = f"{system}\n\n{prompt}"
    return prompt, requested_model, requested_effort


def _text(value: Any) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        for key in ("text", "content", "message", "result"):
            if key in value:
                found = _text(value[key])
                if found:
                    return found
    if isinstance(value, list):
        return "".join(_text(item) for item in value)
    return ""


def _result_text(stdout: str) -> str:
    parts: list[str] = []
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        if event.get("type") == "response.output_text.done":
            value = _text(event)
        else:
            item = event.get("item")
            value = (
                _text(item)
                if isinstance(item, dict) and item.get("type") == "agent_message"
                else ""
            )
        if value:
            parts.append(value)
    return "".join(parts)


def main(argv: list[str]) -> int:
    try:
        prompt, requested_model, requested_effort = parse_request(argv)
    except AgentArgumentError as exc:
        _diagnostic(
            "argument-parsing",
            f"Codex bridge {exc}",
            detail=f"received option names: {_option_names(argv)}",
        )

    executable = os.environ.get("CODEX_BIN") or shutil.which("codex")
    if not executable:
        _diagnostic(
            "executable-resolution", "Codex executable was not found", exit_code=127
        )

    model = os.environ.get("GEPA_CODEX_MODEL") or DEFAULT_MODEL
    effort = (
        os.environ.get("GEPA_REASONING_EFFORT") or requested_effort or DEFAULT_EFFORT
    )
    if (
        requested_model
        and not os.environ.get("GEPA_CODEX_MODEL")
        and requested_model.startswith("gpt-")
    ):
        model = requested_model
    command = [
        executable,
        "exec",
        "--json",
        "--dangerously-bypass-approvals-and-sandbox",
        "-C",
        os.getcwd(),
        "--model",
        model,
        "-c",
        f"model_reasoning_effort={effort}",
        "-",
    ]
    try:
        completed = subprocess.run(
            command,
            input=prompt,
            capture_output=True,
            check=False,
            text=True,
        )
    except OSError as exc:
        _diagnostic("backend-launch", f"could not execute Codex: {exc}", exit_code=127)

    print(
        json.dumps(
            {
                "type": "result",
                "result": _result_text(completed.stdout),
                "is_error": completed.returncode != 0,
                "total_cost_usd": 0.0,
                "usage": {},
            }
        )
    )
    if completed.returncode:
        _diagnostic(
            "backend-execution",
            f"Codex exited with status {completed.returncode}",
            detail=(
                completed.stderr or completed.stdout or "no diagnostic output"
            ).strip(),
            exit_code=completed.returncode,
        )
    return 0


if __name__ == "__main__":
    if "--print" not in sys.argv[1:]:
        _diagnostic(
            "argument-validation", "Codex bridge only accepts GEPA's --print contract"
        )
    raise SystemExit(main(sys.argv[1:]))
